# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.[project-ref]:password@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase (public — safe for client-side)
PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Rate Limiting (Upstash Redis) — optional in development
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# API subdomain hostname — optional, defaults to api.logmaxing.tech
# API_HOST=api.logmaxing.tech

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_DEVELOPER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx
